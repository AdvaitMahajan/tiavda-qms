# ─── Server ────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=8080
LOG_LEVEL=info

# Comma-separated list of allowed browser origins (the Vite app URL).
# Use "*" only for local dev. In production set the real frontend origin(s).
CORS_ORIGINS=http://localhost:5173

# Rate limiting (per IP)
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=300

# ─── Database (Supabase Postgres) ────────────────────────────────────────────
# Use the SESSION POOLER connection string from:
#   Supabase Dashboard -> Project Settings -> Database -> Connection string (URI)
# Railway is a persistent container, so the session pooler (port 5432) is fine.
DATABASE_URL=postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres

# ─── Supabase services we still rely on ──────────────────────────────────────
# Used to: (a) verify auth JWTs, (b) run auth-admin ops (invite/reset),
# (c) read/write Storage objects via the service role.
SUPABASE_URL=https://<ref>.supabase.co
SUPABASE_ANON_KEY=<anon-publishable-key>
SUPABASE_SERVICE_ROLE_KEY=<service-role-secret-key>   # SERVER ONLY — never ship to browser

# Legacy HS256 JWT secret (Dashboard -> Settings -> API -> JWT Secret).
# Optional: only needed if your project still issues HS256 tokens. If the project
# uses the newer asymmetric signing keys, JWKS is fetched from SUPABASE_URL.
SUPABASE_JWT_SECRET=

# ─── Cron protection ─────────────────────────────────────────────────────────
# Shared secret required in the X-Cron-Secret header to trigger /api/cron/* jobs.
CRON_SECRET=

# ─── Integrations (ported edge functions) ────────────────────────────────────
BREVO_API_KEY=
SENDER_EMAIL=noreply@globalgeotechnical.com
SENDER_NAME=Global Geotechnical Consultancy
WATI_API_TOKEN=
WATI_BASE_URL=
GOOGLE_SERVICE_ACCOUNT_B64=
GOOGLE_DRIVE_ROOT_FOLDER_ID=
ADMIN_EMAIL=
ADMIN_WHATSAPP=
APP_URL=https://qms.globalgeoconsultancy.com
COMPANY_STATE=
